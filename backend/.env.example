# MapLess AI Backend Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mapless_db

# CORS Configuration
CORS_ORIGIN=*

# SLM Runtime Configuration (Optional local SLM integration)
SLM_PROVIDER=deterministic
SLM_BASE_URL=http://localhost:11434
SLM_MODEL=llama3.2
SLM_TIMEOUT_MS=10000
