{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlmProviderOutput",
  "description": "Strict contract schema for structured extraction output from an SLM provider in MapLess AI",
  "type": "object",
  "required": [
    "intent",
    "entities",
    "constraints",
    "confidence",
    "ambiguity"
  ],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "FIND_NEAREST",
        "NAVIGATE_TO",
        "LOCATE_ROOM",
        "QUERY_INFO",
        "EMERGENCY_EXIT",
        "FALLBACK"
      ],
      "description": "Recognized user intent code"
    },
    "entities": {
      "type": "array",
      "description": "Extracted semantic tokens and target nouns",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "category",
              "room_name",
              "alias",
              "department",
              "facility",
              "accessibility",
              "floor",
              "node"
            ],
            "description": "Entity category identifier"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Extracted entity value or normalized token"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Whitelisted structured filters for Semantic Knowledge Graph resolution",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string" },
        "name": { "type": "string" },
        "alias": { "type": "string" },
        "category": { "type": "string" },
        "tag": { "type": "string" },
        "department": { "type": "string" },
        "accessible": { "type": "boolean" },
        "facility": { "type": "string" },
        "floor": { "type": "integer" },
        "capacityMin": { "type": "integer", "minimum": 0 }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of SLM interpretation"
    },
    "ambiguity": {
      "type": "boolean",
      "description": "Indicates whether user query had conflicting or underspecified elements"
    },
    "reason": {
      "type": "string",
      "description": "Human-readable explainability rationale for extraction decision"
    }
  }
}
