{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiResponse",
  "description": "Schema for validated structured intent/entity output emitted by the SLM engine in MapLess AI",
  "type": "object",
  "required": ["intent", "entities", "constraints", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "FIND_NEAREST",
        "NAVIGATE_TO",
        "LOCATE_ROOM",
        "QUERY_INFO",
        "EMERGENCY_EXIT",
        "FALLBACK"
      ],
      "description": "Recognized user intent code"
    },
    "entities": {
      "type": "array",
      "description": "Extracted semantic tokens and target nouns",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Entity category (e.g., 'category', 'room_name', 'department')"
          },
          "value": {
            "type": "string",
            "description": "Extracted text or normalized identifier"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Derived filter constraints to apply to the semantic knowledge graph",
      "properties": {
        "category": { "type": "string" },
        "accessible": { "type": "boolean" },
        "floor": { "type": "integer" },
        "amenity": { "type": "string" }
      },
      "additionalProperties": true
    },
    "targetNodeId": {
      "type": ["string", "null"],
      "description": "Resolved node ID if unambiguous match was found in the semantic graph"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of SLM interpretation"
    },
    "responseMessage": {
      "type": "string",
      "description": "Human-friendly conversational response message to be displayed by the UI"
    }
  },
  "additionalProperties": true
}
