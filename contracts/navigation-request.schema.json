{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NavigationRequest",
  "description": "Schema for indoor navigation and route calculation handoff in MapLess AI",
  "type": "object",
  "required": ["buildingId", "destinationNodeId"],
  "properties": {
    "buildingId": {
      "type": "string",
      "description": "Unique identifier of the building where navigation occurs"
    },
    "startNodeId": {
      "type": ["string", "null"],
      "description": "Origin node ID (manually selected by visitor or from visitor context)"
    },
    "destinationNodeId": {
      "type": "string",
      "description": "Target destination node ID"
    },
    "intent": {
      "type": "string",
      "enum": [
        "FIND_NEAREST",
        "NAVIGATE_TO",
        "EMERGENCY_EXIT"
      ],
      "description": "Recognized navigation intent requiring spatial pathfinding"
    },
    "operation": {
      "type": "string",
      "enum": [
        "FIND_NEAREST_TARGET",
        "RESOLVE_DESTINATION",
        "RESOLVE_EMERGENCY_EXIT"
      ],
      "description": "Controlled graph query operation"
    },
    "semanticTarget": {
      "type": "string",
      "description": "Resolved semantic target name, alias, or category"
    },
    "resolvedTarget": {
      "type": "object",
      "description": "Detailed node metadata of the resolved destination",
      "required": ["nodeId", "name", "category"],
      "properties": {
        "nodeId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "floorNumber": { "type": ["integer", "null"] },
        "floorName": { "type": ["string", "null"] },
        "buildingId": { "type": ["string", "null"] },
        "accessible": { "type": "boolean" },
        "department": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "description": "Semantic constraints satisfied by the resolved target",
      "additionalProperties": true
    },
    "preferences": {
      "type": "object",
      "description": "User routing constraints and preferences",
      "properties": {
        "accessible": {
          "type": "boolean",
          "default": false,
          "description": "Requires wheelchair-accessible paths only (avoid stairs/steep slopes)"
        },
        "avoidStairs": {
          "type": "boolean",
          "default": false,
          "description": "Prefers elevators or ramps over staircases"
        },
        "avoidBlockedEdges": {
          "type": "boolean",
          "default": true,
          "description": "Excludes edges marked as obstructed"
        },
        "emergencyMode": {
          "type": "boolean",
          "default": false,
          "description": "Routes toward nearest verified emergency exits"
        }
      },
      "additionalProperties": true
    },
    "requiresNearest": {
      "type": "boolean",
      "description": "Indicates spatial engine should optimize for nearest candidate"
    },
    "requiresRoute": {
      "type": "boolean",
      "description": "Indicates physical pathfinding is required"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of semantic interpretation"
    },
    "ambiguity": {
      "type": "boolean",
      "description": "Ambiguity state of request"
    }
  },
  "additionalProperties": false
}
